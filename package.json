{
  "name": "just-di",
  "version": "0.0.1",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "lint": "biome lint --write",
    "format": "biome format --write",
    "types": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@swc/core": "1.15.33",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.9",
    "vitest": "4.1.6"
  }
}
